canal.instance.master.address=127.0.0.1:3306
canal.instance.dbUsername=CHANGE_ME
canal.instance.dbPassword=CHANGE_ME
canal.instance.connectionCharset=UTF-8

# The schema contains a table named `like`; Canal 1.1.7's Druid parser treats
# LIKE as a keyword while rebuilding TSDB metadata, so local TSDB is disabled.
canal.instance.tsdb.enable=false
canal.instance.gtidon=false
