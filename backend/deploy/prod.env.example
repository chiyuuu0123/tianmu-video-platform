# Spring Boot production profile
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8101
NETTY_PORT=9101

# MySQL, Redis, Elasticsearch, RocketMQ and Canal stay on the server's private interface.
TIANMU_DB_URL='jdbc:mysql://127.0.0.1:3306/tianmu?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai'
TIANMU_DB_USERNAME=tianmu
TIANMU_DB_PASSWORD=CHANGE_ME
TIANMU_DB_MAX_POOL_SIZE=20
TIANMU_DB_MIN_IDLE=5

TIANMU_REDIS_DATABASE=15
TIANMU_REDIS_HOST=127.0.0.1
TIANMU_REDIS_PORT=6379
TIANMU_REDIS_PASSWORD=CHANGE_ME

TIANMU_ES_URIS=http://127.0.0.1:9200
TIANMU_ES_USERNAME=elastic
TIANMU_ES_PASSWORD=CHANGE_ME

# Internal MinIO endpoint for the backend, and public endpoint returned to browsers.
TIANMU_MINIO_URL=http://127.0.0.1:9000
TIANMU_MINIO_PUBLIC_URL=https://minio.example.com
TIANMU_MINIO_ACCESS_KEY=CHANGE_ME
TIANMU_MINIO_SECRET_KEY=CHANGE_ME
TIANMU_MINIO_BUCKET=tianmu-upload

TIANMU_ROCKETMQ_NAMESERVER=127.0.0.1:9876

TIANMU_CANAL_HOST=127.0.0.1
TIANMU_CANAL_PORT=11111
TIANMU_CANAL_USERNAME=canal
TIANMU_CANAL_PASSWORD=CHANGE_ME

# Generate with: openssl rand -base64 32
TIANMU_JWT_SECRET=CHANGE_ME_TO_A_BASE64_ENCODED_32_BYTE_KEY
TIANMU_JWT_EXPIRATION_HOURS=48

TIANMU_CORS_ALLOWED_ORIGIN_PATTERNS=https://www.example.com

TIANMU_MAIL_HOST=smtp.qq.com
TIANMU_MAIL_USERNAME=CHANGE_ME
TIANMU_MAIL_AUTH_CODE=CHANGE_ME
TIANMU_MAIL_SENDER_NAME=天幕
